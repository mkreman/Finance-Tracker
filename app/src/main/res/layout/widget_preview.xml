<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="center_vertical"
    android:background="#F5F5F5">

    <ImageView
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="8dp">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_preview_expense_bg"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_upward"
            app:tint="#B3261E"
            android:contentDescription="Expense" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_preview_income_bg"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_downward"
            app:tint="#146C2E"
            android:contentDescription="Income" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_preview_transfer_bg"
            android:padding="10dp"
            android:src="@drawable/ic_swap_horiz"
            app:tint="#1D4E89"
            android:contentDescription="Transfer" />
    </LinearLayout>

</LinearLayout>
